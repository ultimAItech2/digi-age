    {
      "id": "lattice_blackout",
      "kind": "voice",
      "speaker": "lattice",
      "voice_id": "pFZP5JQG7iQjIQuC4Bku",
      "text": "Power is a privilege. We revoked it.",
      "file": "voice/lattice_blackout.mp3",
      "sha256": "89600f64d3f0b75dc83da78603ec3765c5c90535a63cba17b007b819dabc292b"
    },
    {
      "id": "second_raid",
