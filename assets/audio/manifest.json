      "sha256": "be42347202cb9ec6d58441a89b4b7f9e8734af994699e8c5c8ab1113c4434de4"
    },
    {
      "id": "ambush",
      "kind": "voice",
      "speaker": "foundry",
      "voice_id": "pNInz6obpgDQGcFmaJgB",
      "text": "Convoy sighted. Cut the escort and take the archive.",
