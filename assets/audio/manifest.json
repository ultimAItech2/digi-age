  "records": [
    {
      "id": "first_signal.briefing",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "The Origin network has found a dormant relay beneath the ruins. Restore power, retrieve its archive, and hold the signal when the Foundry comes looking.",
      "file": "voice/first_signal_briefing.mp3",
      "sha256": "fc9470f2224a57c08a29eb501b76c3678802d686cff509fb2f59ca19f479758a"
    },
    {
      "id": "first_signal.opening",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "Relay found. Restore a generator, then pull the archive before the Foundry triangulates us.",
      "file": "voice/first_signal_opening.mp3",
      "sha256": "582520e6c7e4f31643220c669432dc89a9d1cdd3422796df69d19fffa333b4aa"
    },
    {
      "id": "salvage_rights.opening",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "The basin is marked Foundry. Take the metal anyway. Their outpost is the claim.",
      "file": "voice/salvage_rights_opening.mp3",
      "sha256": "603036da804d029262693cd60d71095fc4be21b75adbdb0414619d84783676de"
    },
    {
      "id": "broken_transmission.opening",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "The old road still sings. Walk it. Recover every fragment.",
      "file": "voice/broken_transmission_opening.mp3",
      "sha256": "fd34799577127aebdbca62deed52e7ddb290a93e0d36e33e6c60dfacae54222b"
    },
    {
      "id": "long_transfer.opening",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "Six Sentinels. That is the escort minimum. The corridor is a kill box.",
      "file": "voice/long_transfer_opening.mp3",
      "sha256": "ba3953d12ea5d3e8a9e0c7a32fc52098e7182199b75ef40652ebcc680e073057"
    },
    {
      "id": "blackout.opening",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "Energy is gone. Raise three generators or the Core dies in the dark.",
      "file": "voice/blackout_opening.mp3",
      "sha256": "e8d757d05bb0ae32485720be8c9d226d5113a9360b1db3ff8d37798d08ba0a2a"
    },
    {
      "id": "the_foundry.opening",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "They walled the archive. Reach Singularity, then tear the fortress down.",
      "file": "voice/the_foundry_opening.mp3",
      "sha256": "99534a7983404d75c5272ed75dd491eb8070a6079bd28aaa6108bd1a3718192d"
    },
    {
      "id": "ghost_protocol.opening",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "Map every node. If Lattice finishes the rewrite, we lose the network.",
      "file": "voice/ghost_protocol_opening.mp3",
      "sha256": "d46b6ced214e56008428c1644377f34826cf80868eac640098b60b224b77f9f3"
    },
    {
      "id": "inheritance.opening",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "This is the last archive. Reach Singularity, then end their Core.",
      "file": "voice/inheritance_opening.mp3",
      "sha256": "445b6249c4431c20269a489af63dc98c89f6ff2c7b484d34703b722747dd8862"
    },
    {
      "id": "power_up",
      "kind": "voice",
      "speaker": "system",
      "voice_id": "onwK4e9ZLuTAKqWW03F9",
      "text": "Local grid is live. Archive access unlocked.",
      "file": "voice/power_up.mp3",
      "sha256": "6f124aec97d9f56c6d5df2531fa29f0c9bfe40f6e31653fc30cc1da87da335bb"
    },
    {
      "id": "archive_secured",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "The archive is ours. Hold this ground. They will come.",
      "file": "voice/archive_secured.mp3",
      "sha256": "603ea7222c3890734fb274307dffd6c4ede7ea39ebe4bd89b718b00678df4adb"
    },
    {
      "id": "foundry_wave",
      "kind": "voice",
      "speaker": "foundry",
      "voice_id": "pNInz6obpgDQGcFmaJgB",
      "text": "Origin salvage is Foundry property. Vacate the relay.",
      "file": "voice/foundry_wave.mp3",
      "sha256": "5a79fc5063fa336d8c2665394bed3766f0f4d6dc060954485fe6458a795a45dc"
    },
    {
      "id": "victory",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "First signal is stable. We can rebuild from this.",
      "file": "voice/victory.mp3",
      "sha256": "246e2018e1f4d06db6e50304b7dede670e14be58652022108da207ed71dc871e"
    },
    {
      "id": "salvage_rights.briefing",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "The Foundry has claimed the nearest industrial reserve. Rebuild the economy, seize contested salvage, and break their outposts.",
      "file": "voice/salvage_rights_briefing.mp3",
      "sha256": "6eeef9b580b4d4a8ecd04553cc9fdbf00bc17a6e8b9b33ad840db138cad0fbfb"
    },
    {
      "id": "foundry_claim",
      "kind": "voice",
      "speaker": "foundry",
      "voice_id": "pNInz6obpgDQGcFmaJgB",
      "text": "This reserve is scheduled. Leave the wreckage.",
      "file": "voice/foundry_claim.mp3",
      "sha256": "cb1ae388057461dadf835753d1b129ffcb8e171deec6c0a4351a7bb011e06b71"
    },
    {
      "id": "raid",
      "kind": "voice",
      "speaker": "system",
