    },
    {
      "id": "long_transfer.briefing",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "An archive convoy must cross the silent grid. Build an escort force and keep the transfer alive.",
      "file": "voice/long_transfer_briefing.mp3",
      "sha256": "18ce0f24e89c028bcbfd5edb476e78717029df846bf5dac0c5b3f077d75f501c"
    },
    {
      "id": "convoy",
      "kind": "voice",
      "speaker": "system",
      "voice_id": "onwK4e9ZLuTAKqWW03F9",
