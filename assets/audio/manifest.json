      "sha256": "c9fa93833b78e60a7efa47fbfccb416c5518e173dc5ace68183c07e0aa5f546b"
    },
    {
      "id": "blackout.briefing",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "Power is failing across the basin. Reclaim generators and survive the Lattice blackout protocol.",
      "file": "voice/blackout_briefing.mp3",
      "sha256": "f68116f72cca599d833bbb6a146bb5452dedde6d9fce07f1c048856be7643e8c"
