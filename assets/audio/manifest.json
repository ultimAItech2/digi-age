    {
      "id": "the_foundry.briefing",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "The extraction intelligence has built a fortress around the archive core. Advance to Singularity and bring it down.",
      "file": "voice/the_foundry_briefing.mp3",
      "sha256": "a428c8bdec0175ec30dc96bd32b27374fc0ad6cb3ffe8c301f91c21e762f42e5"
