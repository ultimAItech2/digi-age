      "text": "Foundry raid inbound from the eastern towers.",
      "file": "voice/raid.mp3",
      "sha256": "21e23f85b934bd2615942328bb79743bbf523368ca2c06f755d5c0780da0dba8"
    },
    {
      "id": "broken_transmission.briefing",
      "kind": "voice",
      "speaker": "archivist",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "Relay fragments are broadcasting from the old road. Find them before the Lattice turns their signal against us.",
      "file": "voice/broken_transmission_briefing.mp3",
      "sha256": "4b909d066210d321b91eb67468878a1bfa1fc99b264513105bd65fa618cb4d98"
    },
    {
