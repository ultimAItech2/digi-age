; Digital Age — complete editable Godot project
config_version=5

[application]
config/name="Digital Age: Machine Civilizations"
config/version="1.0.0-rc1"
config/icon="res://assets/icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="An offline real-time strategy game about rival machine civilizations."

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[rendering]
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.055, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
buses/default_bus_layout="res://default_bus_layout.tres"

[physics]
common/physics_ticks_per_second=30
