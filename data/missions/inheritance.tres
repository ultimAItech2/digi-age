[gd_resource type="Resource" script_class="DAMissionDefinition" load_steps=2 format=3]
[ext_resource type="Script" path="res://scripts/mission_definition.gd" id="1"]
[resource]
script = ExtResource("1")
mission_id = "inheritance"
title = "Inheritance"
briefing = "Every surviving archive points to one final choice: preserve the past, or become something new."
map_id = "inheritance_core"
player_faction_id = "origin"
enemy_faction_id = "lattice"
difficulty = "normal"
objectives = [{"id": "complete_inheritance", "title": "Reach Singularity", "kind": "age", "target": "age", "required": 2, "optional": false}, {"id": "destroy_network", "title": "Destroy the opposing command network", "kind": "destroy", "target": "core", "required": 1, "optional": false}]
starting_resources = [Vector3(800.0, 500.0, 120.0), Vector3(850.0, 520.0, 140.0)]
technology_floor = [1, 1]
technology_ceiling = [2, 2]
time_limit = 0.0
dialogue_entries = [{"id": "opening", "speaker": "archivist", "text": "This is the last archive. Reach Singularity, then end their Core."}, {"id": "lattice_final", "speaker": "lattice", "text": "You were always a draft. We are the published version."}, {"id": "ready", "speaker": "system", "text": "Singularity reached. The command network is exposed."}]
events = [{"id": "opening", "kind": "dialogue", "entry": "opening", "trigger": {"at_seconds": 0.4}}, {"id": "lattice_final", "kind": "dialogue", "entry": "lattice_final", "trigger": {"at_seconds": 12.0}}, {"id": "ready", "kind": "dialogue", "entry": "ready", "trigger": {"on_objective": "complete_inheritance"}}, {"id": "final_wave", "kind": "spawn_wave", "trigger": {"on_objective": "complete_inheritance"}, "side": 1, "origin": "enemy", "order": "attack_move", "units": [{"kind": "walker", "count": 1, "offset": Vector2(-6.0, 0.0)}, {"kind": "sentinel", "count": 4, "offset": Vector2(-8.0, 2.0)}, {"kind": "disruptor", "count": 2, "offset": Vector2(-4.0, -2.0)}]}, {"id": "finale_ai", "kind": "ai_override", "trigger": {"at_seconds": 30.0}, "profile": {"attack_start": 90.0, "min_army": 8, "attack_cooldown": 55.0}}]
checkpoint_ids = ["opening", "complete_inheritance", "destroy_network"]
victory_text = "The last archive opens. Origin chooses its own future."
defeat_text = "Lattice inherits everything. The collective ends as a footnote."
